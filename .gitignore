# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Configuración personalizada ---

# Archivos Markdown inútiles (manteniendo el README)
*.md
!README.md

# Scripts locales o sueltos
audit-ui.js
scripts/
*.py
*.sh

# Imágenes raras, carpetas de auditoría y videos
audit-videos/
*.gif
*.mp4
*.webm
*.mkv
